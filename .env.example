# PharmaSure Environment Configuration
# Copy this to .env and adjust for your environment

# Database
DB_ROOT_PASSWORD=pharmasure_root
DB_NAME=pharmasure
DB_USER=pharmasure
DB_PASSWORD=pharmasure_pass

# WordPress
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_DISPLAY=false

# Tenancy & Security
PHARMASURE_ENVIRONMENT=development
PHARMASURE_ENCRYPTION_KEY=change-me-in-production-use-wp-crypto
PHARMASURE_LICENSE_SIGNING_KEY=change-me-production-key
PHARMASURE_LOG_LEVEL=debug

# Licensing Server (for validation)
PHARMASURE_LICENSE_SERVER_URL=https://license.pharmasure.local
PHARMASURE_LICENSE_SERVER_API_KEY=dev-key-only

# Email (MailHog for development)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=noreply@pharmasure.local
MAIL_FROM_NAME=PharmaSure

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: Supabase Bridge (for migration path)
PHARMASURE_SUPABASE_URL=
PHARMASURE_SUPABASE_KEY=

# Optional: Payment Gateway
PHARMASURE_PAYMENT_PROVIDER=stripe
PHARMASURE_PAYMENT_API_KEY=
PHARMASURE_PAYMENT_SECRET_KEY=
