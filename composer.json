{
  "name": "pharmasure/wordpress",
  "description": "PharmaSure - Cloud-First Multi-Tenant Pharmacy Management System",
  "type": "wordpress-site",
  "license": "proprietary",
  "authors": [
    {
      "name": "PharmaSure Team",
      "email": "dev@pharmasure.local"
    }
  ],
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpcompatibility/php-compatibility": "^9.0",
    "wp-cli/wp-cli-bundle": "^2.12"
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "migrate": "@php -r \"if (file_exists('wp-load.php')) { require 'wp-load.php'; do_action('pharmasure_migrate'); }\"",
    "test-isolation": "@php scripts/test-isolation.php",
    "test-license": "@php scripts/test-license.php"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ]
}
